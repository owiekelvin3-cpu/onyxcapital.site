# Onyx Capital — copy to .env.local when you connect a backend.

# Optional branding
NEXT_PUBLIC_APP_NAME=Onyx Capital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add these when you create the new backend
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: send 6-digit signup codes and admin broadcasts through Resend
# RESEND_API_KEY=
# RESEND_FROM=Onyx Capital <support@onyxcapital.site>
# RESEND_FROM_EMAIL=Onyx Capital <support@onyxcapital.site>
# Smartsupp live chat (Settings → Chat box → Chat code)
# NEXT_PUBLIC_SMARTSUPP_KEY=
