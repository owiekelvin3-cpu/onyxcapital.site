{
  "name": "Onyx Capital",
  "short_name": "Onyx Capital",
  "description": "Trade crypto, copy top traders, and manage your portfolio on Onyx Capital.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0a",
  "theme_color": "#0f0f0f",
  "categories": ["finance", "business"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/pwa-icon-192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-icon",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/dashboard",
      "icons": [{ "src": "/pwa-icon-192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Deposit",
      "url": "/dashboard/deposit",
      "icons": [{ "src": "/pwa-icon-192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Withdraw",
      "url": "/dashboard/withdraw",
      "icons": [{ "src": "/pwa-icon-192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Copy Trading",
      "url": "/dashboard/copy-trading",
      "icons": [{ "src": "/pwa-icon-192", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
