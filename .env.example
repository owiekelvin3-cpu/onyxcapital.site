# Onyx Capital — copy to .env.local when you connect a backend.

# Optional branding
NEXT_PUBLIC_APP_NAME=Onyx Capital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add these when you create the new backend
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: send 6-digit signup codes and admin branded mail through Resend
# RESEND_API_KEY=
# MAIL_FROM=Onyx Capital <Onyxcapitalsupport@gmail.com>
# MAIL_REPLY_TO=Onyxcapitalsupport@gmail.com
# Optional: override Tawk.to widget (defaults to the live Onyx Capital property)
# NEXT_PUBLIC_TAWK_PROPERTY_ID=6a9b00c4b52e5034445459fe
# NEXT_PUBLIC_TAWK_WIDGET_ID=default
