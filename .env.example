# Onyx Capital — copy to .env.local when you connect a backend.

# Optional branding
NEXT_PUBLIC_APP_NAME=Onyx Capital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add these when you create the new backend
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: send 6-digit signup codes through Resend instead of the default mailer
# RESEND_API_KEY=
# NEXT_PUBLIC_SMARTSUPP_KEY=
